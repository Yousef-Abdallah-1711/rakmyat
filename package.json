{
  "name": "rakmyat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && node scripts/check-logical-css.mjs",
    "format": "prettier --write --ignore-unknown --ignore-path .prettierignore .",
    "format:check": "prettier --check --ignore-unknown --ignore-path .prettierignore .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "auth:check": "node scripts/check-payload-auth.mjs",
    "db:check": "tsx scripts/check-db.ts",
    "docker:up": "docker compose --env-file .env.local up --build",
    "docker:down": "docker compose --env-file .env.local down"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@sentry/nextjs": "11.7.0",
    "gsap": "3.15.0",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "payload": "3.90.2",
    "pg": "8.16.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@react-three/test-renderer": "9.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
